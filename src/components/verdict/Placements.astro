---
// The answer box: the tier for each place the software can run, most urgent first, with the first thing to do.
// This is the decision, so it comes straight after the header. Reasons are folded.
import '../../styles/verdict/placements.css';
import Text from '../Text.astro';
import { TIERS, type TierNumber } from '../../lib/tiers';
import { placementResult, sortedPlacements, type RecordEntry } from '../../schema/record';

interface Props {
  record: RecordEntry;
}
const { record } = Astro.props;
const all = sortedPlacements(record);
const notable = all.filter((p) => p.tier <= 3);
const routine = all.filter((p) => p.tier === 4);
---

<section class="sec where answer" aria-labelledby="placement-heading">
  <h2 id="placement-heading">Your answer: tier by where it runs</h2>
  {notable.length > 0 && <ul class="places" role="list">
    {notable.map((placement) => {
      const result = placementResult(record, placement);
      const tier = placement.tier as TierNumber;
      const editorial = placement.override_reason !== undefined && result.tier !== tier;
      return (
        <li class={`place t${tier}`}>
          <div class="place-main">
            <span class={`badge t${tier}`}>Tier {tier} · {TIERS[tier].name}</span>
            <div class="place-body">
              <h3>{placement.name}</h3>
              <p class="place-action"><Text text={placement.action} /></p>
              {editorial && (
                <p class="place-override">Editorial call: the rules give Tier {result.tier}.</p>
              )}
            </div>
          </div>
          <details class="reasoning">
            <summary>Why Tier {tier}</summary>
            <ul class="list">
              {placement.why.map((w) => <li><Text text={w} /></li>)}
            </ul>
            <p class="meta-line">How the rules rate it: {result.reason}</p>
            {placement.override_reason && <p class="meta-line">Editorial call: {placement.override_reason}</p>}
          </details>
        </li>
      );
    })}
  </ul>}
  {routine.length > 0 && (
    <p class="routine-rest"><span class="badge t4">Tier 4 · {TIERS[4].name}</span> <span>{routine.map((p) => p.name).join('; ')}</span></p>
  )}
</section>
