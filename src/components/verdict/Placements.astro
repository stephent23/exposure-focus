---
// Your tier by placement, one row each.
import '../../styles/verdict/placements.css';
import Text from '../Text.astro';
import { TIERS, type TierNumber } from '../../lib/tiers';
import { placementResult, sortedPlacements, type RecordEntry } from '../../schema/record';

interface Props {
  record: RecordEntry;
}
const { record } = Astro.props;
---

<section class="sec" aria-labelledby="placement-heading">
  <h2 id="placement-heading">Tier by placement</h2>
  <ul class="places" role="list">
    {sortedPlacements(record).map((placement) => {
      const result = placementResult(record, placement);
      const tier = placement.tier as TierNumber;
      return (
        <li class={`place t${tier}`}>
          <div class="place-main">
            <span class={`badge t${tier}`}>Tier {tier} · {TIERS[tier].name}</span>
            <div class="place-body">
              <h3>{placement.name}</h3>
              <p class="place-action"><Text text={placement.action} /></p>
            </div>
          </div>
          <details class="reasoning">
            <summary>Why Tier {tier}</summary>
            <ul class="list">
              {placement.why.map((w) => <li><Text text={w} /></li>)}
            </ul>
            <p class="meta-line">Rubric: {result.reason}</p>
            {placement.override_reason && <p class="meta-line">Override: {placement.override_reason}</p>}
          </details>
        </li>
      );
    })}
  </ul>
</section>
