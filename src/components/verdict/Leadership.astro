---
// Why this tier: the reason and what would change it. The board summary and the plain-text version are copy
// buttons (src/scripts/copy.ts), so the page does not repeat them; their text is folded for when copying fails.
import '../../styles/verdict/leadership.css';
import { headlineTier, type RecordEntry } from '../../schema/record';

interface Props {
  record: RecordEntry;
  bossText: string;
}
const { record, bossText } = Astro.props;
---

<section class="sec why-sec leadership" aria-labelledby="leadership-heading">
  <h2 id="leadership-heading">Why this tier</h2>
  <dl class="why">
    <div><dt>Why Tier {headlineTier(record)}</dt><dd>{record.tier_reason}</dd></div>
    <div>
      <dt>What would change it</dt>
      <dd>{record.would_change.length === 1 ? record.would_change[0] : <ul>{record.would_change.map((w) => <li>{w}</li>)}</ul>}</dd>
    </div>
  </dl>
  <div class="board">
    <div class="copy-row">
      <button type="button" id="boss-copy-quote" class="copy-btn" data-copy="boss-quote" hidden>Copy summary for the board</button>
      <button type="button" id="boss-copy" class="copy-btn" data-copy="boss-text" hidden>Copy as plain text</button>
      <p id="boss-status" class="boss-status" role="status" aria-live="polite"></p>
    </div>
    <details id="boss-fallback" class="boss-more">
      <summary>Show the text to copy</summary>
      <p class="boss-label">Summary for the board</p>
      <blockquote id="boss-quote">{record.leadership_quote}</blockquote>
      <label for="boss-text">Plain text for an email or chat</label>
      <textarea id="boss-text" readonly rows="6">{bossText}</textarea>
    </details>
  </div>
</section>
