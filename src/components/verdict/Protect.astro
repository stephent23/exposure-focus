---
// What to do: one short row per option (what it is, what it covers, one guide). Everything else is behind "Details".
import '../../styles/verdict/protect.css';
import Text from '../Text.astro';
import { CONFIDENCE_LABELS } from '../../lib/tiers';
import Guide from './Guide.astro';
import { coverageLine, isPlaceholder } from '../../lib/verdict-view';
import type { RecordEntry } from '../../schema/record';

interface Props {
  record: RecordEntry;
}
const { record } = Astro.props;
---

<section class="sec" aria-labelledby="protect-heading">
  <h2 id="protect-heading">What to do</h2>
  <ol class="opts">
    {record.mitigations.map((m) => {
      const [first, ...more] = m.official_guides;
      return (
        <li class="opt">
          <h3>{isPlaceholder(m.title) ? <span class="placeholder">{m.title}</span> : m.title}</h3>
          <p class="opt-line">
            <span class="opt-cover">{coverageLine(record.vectors, m.effect)}</span>
            {first && <span class="opt-guide"><Guide href={first} title={m.title} /></span>}
          </p>
          <details class="opt-more">
            <summary>Details<span class="sr-only"> for {m.title}</span></summary>
            <dl class="facts">
              <div><dt>What it involves</dt><dd><Text text={m.summary} /></dd></div>
              <div><dt>Effort</dt><dd><Text text={m.takes} /></dd></div>
              {m.might_break && <div><dt>Might break</dt><dd><Text text={m.might_break} /></dd></div>}
              {m.cost && <div><dt>Costs</dt><dd><Text text={m.cost} /></dd></div>}
              <div><dt>Check it worked</dt><dd><Text text={m.check_it_worked} /></dd></div>
              <div><dt>Undo</dt><dd><Text text={m.undo} /></dd></div>
              {more.length > 0 && <div><dt>More guides</dt><dd>{more.map((g, i) => <>{i > 0 && ' · '}<Guide href={g} title={m.title} /></>)}</dd></div>}
              <div><dt>Confidence</dt><dd>{CONFIDENCE_LABELS[m.confidence]}</dd></div>
            </dl>
          </details>
        </li>
      );
    })}
  </ol>
</section>
