---
// What to do: one compact row per option, with the full detail behind a disclosure.
import '../../styles/verdict/protect.css';
import Text from '../Text.astro';
import { CONFIDENCE_LABELS, EFFECT_LABELS } from '../../lib/tiers';
import { coverageLine, guideLabel, isPlaceholder, letter } from '../../lib/verdict-view';
import type { RecordEntry } from '../../schema/record';

interface Props {
  record: RecordEntry;
}
const { record } = Astro.props;
---

<section class="sec" aria-labelledby="protect-heading">
  <h2 id="protect-heading">What to do</h2>
  <ol class="opts">
    {record.mitigations.map((m) => (
      <li class="opt">
        <h3>{isPlaceholder(m.title) ? <span class="placeholder">{m.title}</span> : m.title}</h3>
        <p class="opt-cover">{coverageLine(record.vectors, m.effect)}</p>
        <p class="opt-effort">Effort: <Text text={m.takes} /></p>
        <details class="opt-more">
          <summary>Details<span class="sr-only"> for {m.title}</span></summary>
          <p class="opt-sum"><Text text={m.summary} /></p>
          <ul class="opt-ways">
            {record.vectors.map((vector, i) => {
              const effect = m.effect.find((e) => e.vector === vector);
              return (
                <li class={`eff-${effect?.status ?? 'open'}`}>
                  <span class="v">{letter(i)}</span>
                  <span>{isPlaceholder(vector) ? <span class="placeholder">{vector}</span> : vector}: <b>{EFFECT_LABELS[effect?.status ?? 'open'].text}</b></span>
                </li>
              );
            })}
          </ul>
          <dl class="facts">
            {m.might_break && <div><dt>Might break</dt><dd><Text text={m.might_break} /></dd></div>}
            {m.cost && <div><dt>Costs</dt><dd><Text text={m.cost} /></dd></div>}
            <div><dt>Check it worked</dt><dd><Text text={m.check_it_worked} /></dd></div>
            <div><dt>Undo</dt><dd><Text text={m.undo} /></dd></div>
            <div>
              <dt>{m.official_guides.length === 1 ? 'Guide' : 'Guides'}</dt>
              <dd>
                {m.official_guides.map((g, gi) => (
                  <>
                    {gi > 0 && ' · '}
                    {g.startsWith('http') ? (
                      <a href={g}>{guideLabel(g)}<span class="sr-only"> for {m.title}</span></a>
                    ) : (
                      <span class="placeholder">{g}</span>
                    )}
                  </>
                ))}
              </dd>
            </div>
            <div><dt>Confidence</dt><dd>{CONFIDENCE_LABELS[m.confidence]}</dd></div>
          </dl>
        </details>
      </li>
    ))}
  </ol>
</section>
