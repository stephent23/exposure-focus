---
// "Terms on this page": plain definitions of the words the verdict uses, folded so the answer stays short.
import { termsFor } from '../../lib/glossary';
import type { RecordEntry } from '../../schema/record';

interface Props {
  record: RecordEntry;
}
const { record } = Astro.props;
const terms = termsFor(record);
---

<details class="terms">
  <summary>Terms on this page</summary>
  <dl class="terms-list">
    {terms.map((t) => (
      <div>
        <dt>{t.term}</dt>
        <dd>{t.definition}{t.link && <> <a href={t.link.href}>{t.link.text}</a></>}</dd>
      </div>
    ))}
  </dl>
</details>
