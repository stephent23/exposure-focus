---
// Beside the main column: key dates, the summary for leadership and links to each part of the page.
import '../../styles/verdict/sidebar.css';
import { CONFIDENCE_LABELS } from '../../lib/tiers';
import { niceDate, sortedTimeline } from '../../lib/verdict-view';
import type { RecordEntry } from '../../schema/record';

interface Props {
  record: RecordEntry;
  bossText: string;
}
const { record, bossText } = Astro.props;
const timeline = sortedTimeline(record.timeline);
---

<aside class="sidebar" aria-label="At a glance">
  {timeline.length > 0 && (
    <section class="side-block" aria-labelledby="dates-heading">
      <h2 id="dates-heading">Key dates</h2>
      <p class="sub">Times are UTC. Each date links to where it was stated.</p>
      <ol class="dates">
        {timeline.map((t) => (
          <li class="date-row">
            <time datetime={t.time ? `${t.date}T${t.time}Z` : t.date}>{niceDate(t.date)}{t.time && <span class="date-time"> · {t.time} UTC</span>}</time>
            <span class="date-event">{t.event}</span>
            <span class="date-src">
              {CONFIDENCE_LABELS[t.confidence]} ·{' '}
              {t.source_url.startsWith('http') ? <a href={t.source_url}>Source<span class="sr-only"> for {t.event}</span></a> : <span class="placeholder">{t.source_url}</span>}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="side-block" aria-labelledby="leadership-heading">
    <h2 id="leadership-heading">For leadership</h2>
    <blockquote>{record.leadership_quote}</blockquote>
    <div class="boss">
      <button type="button" id="boss-copy" class="copy-btn" hidden>Copy summary for leadership</button>
      <p id="boss-status" class="boss-status" role="status" aria-live="polite"></p>
      <div id="boss-fallback" class="boss-fallback">
        <label for="boss-text">Summary you can copy and paste</label>
        <textarea id="boss-text" readonly rows="10">{bossText}</textarea>
      </div>
    </div>
  </section>

  <nav class="side-block toc" aria-label="On this page">
    <h2>On this page</h2>
    <ul>
      <li><a href="#placement-heading">Your tier</a></li>
      <li><a href="#applies-heading">Does it apply to you?</a></li>
      {(record.changes ?? []).length > 0 && <li><a href="#changes-heading">Changes</a></li>}
      <li><a href="#protect-heading">Patch and mitigate</a></li>
      {record.were_you_hit && <li><a href="#hit-heading">Were you already hit?</a></li>}
      <li><a href="#evidence-heading">Evidence</a></li>
      {record.analysis && <li><a href="#analysis-heading">Analysis</a></li>}
      <li><a href="#sources-heading">Sources</a></li>
    </ul>
  </nav>
</aside>
