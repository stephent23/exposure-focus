---
// The home page: every verdict grouped by tier, with a filter.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { ATTACKS } from '../lib/attacks';
import { buildDate } from '../lib/today';
import { getAllRecords } from '../lib/records';
import { TIERS, TIER_NUMBERS } from '../lib/tiers';
import { groupForHome } from '../lib/home';
import { headlinePlacement, isStale, sortedPlacements } from '../schema/record';

const today = buildDate();
const groups = groupForHome(await getAllRecords());
const records = groups.flatMap((g) => g.records);
const asOf = records.map((r) => r.evidence_as_of).sort().at(-1);
---

<Base title="Exposure Focus" current="home">
  <section class="hero">
    <p class="eyebrow">Evidence as of {asOf ?? 'n/a'} (UTC)</p>
    <h1>What needs a response, and what can wait.</h1>
    <p class="lede">
      Independent verdicts for security teams. Every call shows its evidence and its date, so you can defend it to your boss.
    </p>
    <p class="note">A placement is where the software sits in your setup, for example internet-facing or inside your network. Each verdict gives a tier for every placement.</p>
    <ul class="pills" aria-label="Verdicts by highest tier">
      {groups.map(({ tier, records: group }) => (
        <li>
          {group.length > 0 ? (
            <a class={`pill t${tier}`} href={`#tier-${tier}`}><b>{group.length}</b> <span>{TIERS[tier].name}</span></a>
          ) : (
            <span class={`pill t${tier} empty`}><b>0</b> <span>{TIERS[tier].name}</span></span>
          )}
        </li>
      ))}
    </ul>

    <form class="filters" id="filters" role="search" aria-label="Filter verdicts">
      <label class="sr-only" for="q">Search name, CVE or alias</label>
      <input id="q" class="search" type="search" placeholder="Search name, CVE or alias" autocomplete="off" />
      <fieldset class="seg">
        <legend class="sr-only">Show verdicts with a tier of</legend>
        {TIER_NUMBERS.map((tier) => (
          <label class={`seg-item t${tier}`}><input type="checkbox" name="tier" value={tier} /><span>Tier {tier}</span></label>
        ))}
      </fieldset>
      <label class="sr-only" for="kind">Type of attack</label>
      <select id="kind" class="select">
        <option value="">All attack types</option>
        {Object.entries(ATTACKS).map(([key, a]) => <option value={key}>{a.name}</option>)}
      </select>
      <button type="reset" class="reset" id="reset" hidden>Clear</button>
      <p class="count" id="count" role="status" aria-live="polite">{records.length} verdicts</p>
    </form>
  </section>

  <div id="all">
    {groups.filter((g) => g.records.length > 0).map(({ tier, records: group }) => (
      <section class={`band t${tier}`} aria-labelledby={`tier-${tier}`} data-band>
        <header>
          <h2 id={`tier-${tier}`}>{TIERS[tier].name}</h2>
          <p>{TIERS[tier].meaning}</p>
        </header>
        <div class="cards">
          {group.map((record) => {
            const primary = headlinePlacement(record);
            return (
              <article
                class="card"
                data-record={record.slug}
                data-tiers={[...new Set(record.placements.map((p) => p.tier))].join(' ')}
                data-kind={record.attack}
                data-text={[record.name, ...record.cves, ...record.aliases].join(' ').toLowerCase()}
              >
                <div class="badges">
                  <span class="badge plain">{ATTACKS[record.attack].name}</span>
                  {record.evidence.some((e) => e.confidence === 'reported') && <span class="badge plain">Some facts unconfirmed</span>}
                  {isStale(record, today) && <span class="badge stale">Overdue for review</span>}
                </div>
                <div>
                  <h3><a href={`/verdicts/${record.slug}/`}>{record.name}</a></h3>
                  <p class="mono">{record.cves.join(' · ')}{record.aliases.length > 0 && ` · also ${record.aliases.join(', ')}`}</p>
                </div>
                <p class="summary">{record.summary}</p>
                <ul class="rows" aria-label="Placements">
                  {sortedPlacements(record).map((placement) => (
                    <li>
                      <span>{placement.name}</span>
                      <span class={`badge t${placement.tier}`}>Tier {placement.tier}</span>
                    </li>
                  ))}
                </ul>
                <p class="todo"><strong>{primary.name}:</strong> {primary.action}</p>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
  <p id="none" class="note" hidden>No verdicts match these filters. Clear them to see every verdict.</p>

  <aside class="panel">
    <h2>Why every verdict is split by placement</h2>
    <p class="prose">
      A vulnerability is not urgent everywhere it exists. The same flaw can need an emergency response on an internet-facing server and
      your normal patching inside the network. Each placement gets its own tier, so effort goes where it reduces real risk.
    </p>
    <p><a href="/rubric/">See how verdicts are decided</a></p>
  </aside>

  <script>
    import '../scripts/filters';
  </script>
</Base>
