---
// The home page: a briefing. What changed lately, then every verdict as one dense row, most urgent first.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { ATTACKS } from '../lib/attacks';
import { buildDate } from '../lib/today';
import { getAllRecords } from '../lib/records';
import { TIERS, TIER_NUMBERS } from '../lib/tiers';
import { freshness, groupForHome, lastChanged, recentActivity } from '../lib/home';
import { niceDate, shortDate } from '../lib/verdict-view';
import { isStale, sortedPlacements } from '../schema/record';

const today = buildDate();
const groups = groupForHome(await getAllRecords());
const records = groups.flatMap((g) => g.records);
const activity = recentActivity(records);
const checked = records.map((r) => r.evidence_as_of).sort().at(-1);
const exploited = (r: (typeof records)[number]) => r.placements.some((p) => p.facts.exploited === true);
const FRESH = { new: 'New', changed: 'Changed' } as const;
---

<Base title="Exposure Focus" current="home">
  <section class="hero">
    <div class="brief-head">
      <p class="eyebrow">Evidence checked to {checked ? niceDate(checked) : 'n/a'} (UTC)</p>
      <h1>What needs a response, and what can wait.</h1>
      <p class="lede">Independent verdicts on publicised vulnerabilities: one tier per placement, each with its evidence and date.</p>
      <ul class="tally" aria-label="Verdicts by highest tier">
        {groups.map(({ tier, records: group }) => (
          <li class={`t${tier}`}>
            {group.length > 0 ? (
              <a href={`#tier-${tier}`}><b>{group.length}</b> <span>{TIERS[tier].name}</span></a>
            ) : (
              <span class="empty"><b>0</b> <span>{TIERS[tier].name}</span></span>
            )}
          </li>
        ))}
        <li class="tally-hot"><span><b>{records.filter(exploited).length}</b> <span>Exploited in attacks</span></span></li>
      </ul>
    </div>

    {activity.length > 0 && (
      <section class="activity" aria-labelledby="activity-heading">
        <h2 id="activity-heading">Latest changes</h2>
        <ol>
          {activity.map((a) => (
            <li class="activity-row">
              <time datetime={a.date}>{shortDate(a.date)}</time>
              <span><a href={`/verdicts/${a.slug}/`}>{a.name}</a> <span class="activity-detail">{a.detail}</span></span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </section>

  <form class="filters" id="filters" role="search" aria-label="Filter verdicts">
    <label class="sr-only" for="q">Search name, CVE or alias</label>
    <input id="q" class="search" type="search" placeholder="Search name, CVE or alias" autocomplete="off" />
    <fieldset class="seg">
      <legend class="sr-only">Show verdicts with a tier of</legend>
      {TIER_NUMBERS.map((tier) => (
        <label class={`seg-item t${tier}`}><input type="checkbox" name="tier" value={tier} /><span>Tier {tier}</span></label>
      ))}
    </fieldset>
    <label class="sr-only" for="kind">Type of attack</label>
    <select id="kind" class="select">
      <option value="">All attack types</option>
      {Object.entries(ATTACKS).map(([key, a]) => <option value={key}>{a.name}</option>)}
    </select>
    <button type="reset" class="reset" id="reset" hidden>Clear</button>
    <p class="count" id="count" role="status" aria-live="polite">{records.length} verdicts</p>
  </form>

  <div id="all">
    {groups.filter((g) => g.records.length > 0).map(({ tier, records: group }) => (
      <section class={`band t${tier}`} aria-labelledby={`tier-${tier}`} data-band>
        <header>
          <h2 id={`tier-${tier}`}><span class="badge">Tier {tier}</span> {TIERS[tier].name}</h2>
          <p>{TIERS[tier].meaning}</p>
        </header>
        <div class="cards">
          {group.map((record) => {
            const fresh = freshness(record, today);
            const changed = lastChanged(record);
            return (
              <article
                class="card"
                data-record={record.slug}
                data-tiers={[...new Set(record.placements.map((p) => p.tier))].join(' ')}
                data-kind={record.attack}
                data-text={[record.name, ...record.cves, ...record.aliases].join(' ').toLowerCase()}
              >
                <div class="card-main">
                  <h3><a href={`/verdicts/${record.slug}/`}>{record.name}</a></h3>
                  <p class="mono">{record.cves.join(' · ')}{record.aliases.length > 0 && ` · also ${record.aliases.join(', ')}`}</p>
                  <p class="summary">{record.summary}</p>
                  <p class="tags">
                    <span>{ATTACKS[record.attack].name}</span>
                    {exploited(record) && <span class="tag-hot">Exploited in attacks</span>}
                    {record.evidence.some((e) => e.confidence === 'reported') && <span>Some facts unconfirmed</span>}
                    {isStale(record, today) && <span class="tag-stale">Overdue for review</span>}
                  </p>
                </div>
                <ul class="rows" aria-label="Placements">
                  {sortedPlacements(record).map((placement) => (
                    <li>
                      <span class={`badge t${placement.tier}`}>Tier {placement.tier}</span>
                      <span>{placement.name}</span>
                    </li>
                  ))}
                </ul>
                <p class="when">
                  {fresh && <span class="fresh">{FRESH[fresh]}</span>}
                  <span>Added <time datetime={record.published}>{shortDate(record.published)}</time></span>
                  {changed && <span>Changed <time datetime={changed}>{shortDate(changed)}</time></span>}
                </p>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
  <p id="none" class="note" hidden>No verdicts match these filters. Clear them to see every verdict.</p>

  <p class="note home-foot">Each verdict gives a tier per placement: where the software sits in your setup. <a href="/rubric/">How verdicts are decided</a></p>

  <script>
    import '../scripts/filters';
  </script>
</Base>
