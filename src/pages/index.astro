---
// The home page: a briefing. What changed lately, then every verdict as one dense row, most urgent first.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { ATTACKS } from '../lib/attacks';
import { buildDate } from '../lib/today';
import { getAllRecords } from '../lib/records';
import { TIERS, TIER_NUMBERS } from '../lib/tiers';
import { fixTitle, freshness, groupForHome, lastChanged, lastTierMove, recentActivity } from '../lib/home';
import { keyFacts, niceDate, shortDate } from '../lib/verdict-view';
import { cveLink, getWatching } from '../lib/watching';
import { headlineTier, isStale, sortedPlacements } from '../schema/record';

const today = buildDate();
const groups = groupForHome(await getAllRecords());
const records = groups.flatMap((g) => g.records);
const activity = recentActivity(records, 5);
// Anything that already has a published verdict drops off the watching list by itself.
const rated = new Set(records.flatMap((r) => [...r.cves, ...(r.related_cves ?? [])]));
const watching = (await getWatching()).filter((w) => !w.cves.some((id) => rated.has(id)));
const checked = records.map((r) => r.evidence_as_of).sort().at(-1);
const exploited = (r: (typeof records)[number]) => r.placements.some((p) => p.facts.exploited === true);
const FRESH = { new: 'New', changed: 'Changed' } as const;
const SHOW_CONTROLS_ABOVE = 15;
const showControls = records.length > SHOW_CONTROLS_ABOVE;
// Placements worth acting on (tier 1-3), highest first, one per line.
const actItems = (r: (typeof records)[number]) =>
  sortedPlacements(r).filter((p) => p.tier <= 3).map((p) => `Tier ${p.tier}: ${p.name}`);
---

<Base title="Exposure Focus" current="home">
  <section class="hero">
    <div class="brief-head">
      <p class="eyebrow">Evidence checked to {checked ? niceDate(checked) : 'n/a'} (UTC)</p>
      <h1>What needs a response, and what can wait.</h1>
      <p class="lede">Independent verdicts on publicised vulnerabilities: one tier per placement, each with its evidence and date.</p>
      <ul class="tally" aria-label="Verdicts by highest tier">
        {groups.map(({ tier, records: group }) => (
          <li class={`t${tier}`}>
            {group.length > 0 ? (
              <a href={`#tier-${tier}`}><b>{group.length}</b> <span>{TIERS[tier].name}</span></a>
            ) : (
              <span class="empty"><b>0</b> <span>{TIERS[tier].name}</span></span>
            )}
          </li>
        ))}
        <li class="tally-hot"><span><b>{records.filter(exploited).length}</b> <span>Exploited in the wild</span></span></li>
      </ul>
    </div>

    {activity.length > 0 && (
      <section class="activity" aria-labelledby="activity-heading">
        <h2 id="activity-heading">Latest changes</h2>
        <ol>
          {activity.map((a) => (
            <li class="activity-row">
              <time datetime={a.date}>{shortDate(a.date)}</time>
              <div>
                <a href={`/verdicts/${a.slug}/`}>{a.name}</a>
                <span class="activity-detail">{a.detail}</span>
                {a.reason && (
                  <details class="why-moved">
                    <summary>Why</summary>
                    <p>{a.reason}</p>
                  </details>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}
  </section>

  <form class="filters" id="filters" role="search" aria-label="Filter verdicts">
    <label class="sr-only" for="q">Search name, CVE or alias</label>
    <input id="q" class="search" type="search" placeholder="Search name, CVE or alias" autocomplete="off" />
    {showControls && (
      <>
        <fieldset class="seg">
          <legend class="sr-only">Show verdicts with a tier of</legend>
          {TIER_NUMBERS.map((tier) => (
            <label class={`seg-item t${tier}`}><input type="checkbox" name="tier" value={tier} /><span>Tier {tier}</span></label>
          ))}
        </fieldset>
        <label class="sr-only" for="kind">Type of attack</label>
        <select id="kind" class="select">
          <option value="">All attack types</option>
          {Object.entries(ATTACKS).map(([key, a]) => <option value={key}>{a.name}</option>)}
        </select>
        <button type="reset" class="reset" id="reset" hidden>Clear</button>
      </>
    )}
    <p class="count" id="count" role="status" aria-live="polite">{records.length} verdicts</p>
  </form>

  <div id="all">
    {groups.filter((g) => g.records.length > 0).map(({ tier, records: group }) => (
      <section class={`band t${tier}`} aria-labelledby={`tier-${tier}`} data-band>
        <header>
          <h2 id={`tier-${tier}`}>{TIERS[tier].name}</h2>
          <p>{TIERS[tier].meaning}</p>
        </header>
        <div class="cards">
          {group.map((record) => {
            const fresh = freshness(record, today);
            const latest = lastChanged(record);
            // A change on the publication day is part of the verdict itself, not a later change.
            const changed = latest && latest > record.published ? latest : undefined;
            const act = actItems(record);
            const fix = fixTitle(record);
            const fixStatus = keyFacts(record).find((f) => f.label === 'Fix');
            const move = lastTierMove(record);
            return (
              <article
                class={`card t${headlineTier(record)}`}
                data-record={record.slug}
                data-tiers={[...new Set(record.placements.map((p) => p.tier))].join(' ')}
                data-kind={record.attack}
                data-text={[record.name, ...record.cves, ...(record.related_cves ?? []), ...record.aliases].join(' ').toLowerCase()}
              >
                <div class="card-main">
                  <div class="card-head">
                    <h3><a href={`/verdicts/${record.slug}/`}>{record.name}</a></h3>
                    <p class="when">
                      <span class="fresh" data-published={record.published} data-changed={changed} hidden={!fresh}>{fresh ? FRESH[fresh] : ''}</span>
                      {changed
                        ? <span>Changed <time datetime={changed}>{shortDate(changed)}</time></span>
                        : <span>Added <time datetime={record.published}>{shortDate(record.published)}</time></span>}
                    </p>
                  </div>
                  <p class="flags">
                    {exploited(record) && <span class="tag-hot">Exploited in the wild</span>}
                    {fixStatus && <span class="tag-fix">Fix: {fixStatus.value.toLowerCase()}</span>}
                    <span class="tag-stale" data-review-until={record.review_until} hidden={!isStale(record, today)}>Overdue for review</span>
                    {move && <span class="tier-move">Tier {move.from} → {move.to}, <time datetime={move.date}>{shortDate(move.date)}</time></span>}
                  </p>
                  <p class="summary">{record.summary}</p>
                  <p class="fixline">{fix ? `Fix: ${fix}` : 'No fix yet'}</p>
                </div>
                {act.length > 0 && (
                  <div class="card-side">
                    <p class="act">{act.map((line) => <span>{line}</span>)}</p>
                  </div>
                )}
              </article>
            );

          })}
        </div>
      </section>
    ))}
  </div>
  <p id="none" class="note" hidden>No verdicts match these filters. Clear them to see every verdict.</p>

  {watching.length > 0 && (
    <section class="watching" aria-labelledby="watching-heading">
      <header>
        <h2 id="watching-heading">Watching, not yet rated</h2>
        <p>Publicised and being looked at. No verdict yet, so no tier: absence from this site is not a rating.</p>
      </header>
      <ul>
        {watching.map((w) => (
          <li class="watch-row">
            <span class="watch-name">{w.name}</span>
            <span class="mono">
              {w.cves.map((id, i) => <>{i > 0 && ' · '}<a href={cveLink(id)}>{id}</a></>)}
            </span>
            <span class="watch-date">Noted <time datetime={w.noted}>{shortDate(w.noted)}</time></span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="note home-foot">Each verdict gives a tier per placement: where the software sits in your setup. <a href="/rubric/">How verdicts are decided</a></p>

  <script>
    import '../scripts/filters';
  </script>
  <script>
    import '../scripts/freshness';
  </script>
</Base>
