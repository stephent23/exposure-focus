---
// One verdict page, built from a record: a compact dashboard with detail folded away.
import Base from '../../layouts/Base.astro';
import '../../styles/verdict.css';
import Summary from '../../components/verdict/Summary.astro';
import Leadership from '../../components/verdict/Leadership.astro';
import Affected from '../../components/verdict/Affected.astro';
import Placements from '../../components/verdict/Placements.astro';
import Protect from '../../components/verdict/Protect.astro';
import Detail from '../../components/verdict/Detail.astro';
import { bossSummary } from '../../lib/boss-summary';
import { buildDate } from '../../lib/today';
import { getAllRecords } from '../../lib/records';
import { isStale } from '../../schema/record';

export async function getStaticPaths() {
  const records = await getAllRecords();
  return records.map((record) => ({ params: { slug: record.slug }, props: { record } }));
}

const { record } = Astro.props;
const stale = isStale(record, buildDate());
const bossText = bossSummary(record, new URL(`/verdicts/${record.slug}/`, Astro.site).href);
---

<Base title={record.name} description={record.summary}>
  <div class="record">
    <Summary record={record} stale={stale} />
    <Leadership record={record} bossText={bossText} />
    <Affected record={record} />
    <Placements record={record} />
    <Protect record={record} />
    <Detail record={record} />
  </div>
  <script>
    import '../../scripts/copy';
  </script>
</Base>
